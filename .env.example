# Public Supabase project settings. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Keep false for the guest-only launch. Change to true later to restore
# email/Google account entry without removing the guest option.
NEXT_PUBLIC_ACCOUNTS_ENABLED=false

# Add the SHA-256 certificate fingerprint shown by Play Console after enabling
# Play App Signing. This activates /.well-known/assetlinks.json for the Android app.
ANDROID_APP_SHA256_FINGERPRINT=

# Public HTTPS address of the separately hosted realtime gateway.
# Leave empty on a single-VPS deployment where Nginx serves /realtime on the same domain.
NEXT_PUBLIC_REALTIME_URL=https://realtime-staging.hiddentify.space

# Keep this server-only. Use Supabase's transaction-pooler connection string.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@POOLER_HOST:6543/postgres

# Hostinger scalable deployment
# Build-time public flag. Keep false on the old deployment; set true on Hostinger.
NEXT_PUBLIC_REALTIME_ENABLED=false

# Internal app -> realtime gateway URL used only by the server container.
REALTIME_INTERNAL_URL=http://realtime:4000

# Generate with: openssl rand -hex 32
# Keep private. The app and realtime gateway must use the same value.
REALTIME_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Supabase transaction-pooler connections per app process. Start with 5.
DATABASE_POOL_MAX=5

# Realtime gateway -> Redis. Redis stays private inside Docker.
REDIS_URL=redis://redis:6379

# Comma-separated browser origins allowed to open a cross-origin SSE stream.
ALLOWED_ORIGINS=https://staging.hiddentify.space,https://hiddentify.space
